{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "sync:seeds": "tsx src/core/scripts/sync-seeds.ts",
    "seed": "npm run sync:seeds && tsx src/core/bd/seeds/index.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js -d src/core/bd/index.ts",
    "migration:generate": "tsx src/core/scripts/generate-migration.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "db:setup": "npm run migration:run && npm run seed",
    "build:test": "tsc -p tsconfig.test.json",
    "test:prepare": "node scripts/test-db.mjs",
    "test": "npm run build:test && npm run test:prepare && node dist-test/test/e2e/api.test.js",
    "test:flow": "npm run build:test && npm run test:prepare && node dist-test/test/flow/agencia-paquetes.flow.test.js && node dist-test/test/flow/agente-cotizacion.flow.test.js",
    "test:booking": "npm run build:test && npm run test:prepare && node dist-test/test/flow/booking-paypal.flow.test.js",
    "test:e2e": "npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  }
}
