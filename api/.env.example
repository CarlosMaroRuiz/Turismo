# ============================================================
# Plantilla de variables de entorno para la API.
# Copia este archivo a `.env` y rellena los valores reales:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows CMD)
# El archivo `.env` está ignorado por git y NO debe subirse.
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Autenticación (JWT) ---
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1d

# --- Correo ---
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
MAIL_USER=usuario@ejemplo.com
MAIL_PASS=contraseña_de_aplicacion
MAIL_FROM="Turismo <no-reply@ejemplo.com>"
MAIL_TEST_END=destino@ejemplo.com

# --- Base de datos ---
TYPE_BD=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cambia_esto
DB_NAME=turismo

# --- Usuario administrador inicial ---
SUPER_USER_NAME=Admin
SUPER_USER_EMAIL=admin@ejemplo.com
SUPER_USER_PASSWORD=cambia_esto

# --- Credencial de servicio del bot ---
SERVICE_CLIENT_ID=
SERVICE_CLIENT_SECRET=
SERVICE_CLIENT_SCOPES=catalog:read,quote:write,booking:write

# --- PayPal Checkout ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PUBLIC_API_URL=
