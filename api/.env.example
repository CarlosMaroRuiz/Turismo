# ============================================================
# Plantilla de variables de entorno para la API.
# Copia este archivo a `.env` y rellena los valores reales:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows CMD)
# El archivo `.env` está ignorado por git y NO debe subirse.
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
# APP_URL es la URL PÚBLICA DEL FRONTEND: se usa para armar los enlaces de los
# correos (por ejemplo /activate-account?token=…). No es la URL del API.
# En desarrollo: http://localhost:5173 · En producción: https://app.tudominio.com
APP_URL=http://localhost:5173

# --- Autenticación (JWT) ---
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1d

# --- Correo ---
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
MAIL_USER=usuario@ejemplo.com
MAIL_PASS=contraseña_de_aplicacion
# Gmail: MAIL_HOST=smtp.gmail.com · MAIL_PORT=465 (SSL) o 587 (STARTTLS)
#        MAIL_USER = la cuenta completa · MAIL_PASS = contraseña de aplicación
#        (requiere verificación en 2 pasos; Google ya no permite "apps menos seguras")
#        MAIL_FROM debe ser esa misma cuenta o un alias verificado.
# límite de Gmail: ~500 destinatarios por día.
MAIL_FROM="Turismo <no-reply@ejemplo.com>"
MAIL_TEST_END=destino@ejemplo.com

# --- Base de datos ---
TYPE_BD=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cambia_esto
DB_NAME=turismo

# --- Usuario administrador inicial ---
SUPER_USER_NAME=Admin
SUPER_USER_EMAIL=admin@ejemplo.com
SUPER_USER_PASSWORD=cambia_esto

# --- Opcionales (tienen valores por defecto) ---

# Sesión: TTL del access token y duración del refresh (días)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
BCRYPT_ROUNDS=12

# CORS: orígenes permitidos separados por coma (obligatorio en producción)
CORS_ORIGINS=http://localhost:5173

# Rate limit (por IP; el contador es en memoria por instancia)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REGISTER_MAX=5

# Correo: "fake" no abre SMTP, guarda el correo en memoria y
# (en desarrollo) imprime el enlace de activación en la consola.
MAIL_TRANSPORT=smtp

# Base de datos de pruebas (la suite la recrea en cada corrida)
DB_NAME_TEST=turista_test

# Credencial de servicio para integraciones (el LLM y el bot). Requiere `npm run seed`.
SERVICE_CLIENT_ID=servicio-llm
SERVICE_CLIENT_SECRET=cambia_esto_por_un_secreto
SERVICE_CLIENT_NAME=Servicio LLM
SERVICE_CLIENT_SCOPES=catalog:read,quote:write,booking:write

# Cotizaciones
QUOTE_TTL_MINUTES=15
QUOTE_TAX_RATE=0.16

# --- PayPal Checkout (reservas) ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PUBLIC_API_URL=
