# ============================================================
# Variables de entorno del frontend (Vite).
# Copia este archivo a `.env` y ajusta los valores.
# Solo las variables con prefijo VITE_ llegan al navegador:
# no pongas secretos aquí nunca.
# ============================================================

# Base de la API, incluido el prefijo de versión del contrato
# (servers: [{ url: "/api/v1" }]).
# En desarrollo, apunta directo al puerto de la API:
VITE_API_URL=http://localhost:3000/api/v1
